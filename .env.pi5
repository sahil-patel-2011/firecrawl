HOST=0.0.0.0
PORT=3002
PI5_PROFILE=true
USE_DB_AUTHENTICATION=false
SEARXNG_ENDPOINT=
PLAYWRIGHT_MICROSERVICE_URL=http://127.0.0.1:3000/scrape
PLAYWRIGHT_SERVICE_DIR=/opt/playwright
MAX_CONCURRENT_PAGES=16
BLOCK_MEDIA=true
LOGGING_LEVEL=warn
# Change this before the API is reachable beyond your own network.
PI5_API_KEYS=pi5-local-key
PI5_SOURCE_REPO=https://github.com/sahil-patel-2011/firecrawl
PI5_UPSTREAM_REPO=https://github.com/firecrawl/firecrawl
PI5_FETCH_CONCURRENCY=48
PI5_SEARCH_CONCURRENCY=8
PI5_PER_KEY_RPM=800
