# syntax=docker/dockerfile:1
# One image: Firecrawl API plus Chromium. Build context is the repository root.
FROM node:22-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI=true

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

FROM golang:1.24 AS go-build
WORKDIR /app
COPY apps/api/sharedLibs/go-html-to-md ./sharedLibs/go-html-to-md
RUN cd sharedLibs/go-html-to-md && \
    go mod download && \
    go build -o libhtml-to-markdown.so -buildmode=c-shared html-to-markdown.go

FROM base AS api-build
WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    python3 \
    && rm -rf /var/lib/apt/lists/*

ARG FDB_VERSION=7.3.63
RUN ARCH=$(dpkg --print-architecture) && \
    case "$ARCH" in arm64) FDB_ARCH=aarch64 ;; *) FDB_ARCH=$ARCH ;; esac && \
    curl -fsSL -o /tmp/fdb-clients.deb \
      "https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/foundationdb-clients_${FDB_VERSION}-1_${FDB_ARCH}.deb" && \
    dpkg -i /tmp/fdb-clients.deb && rm /tmp/fdb-clients.deb

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path \
    && chmod -R a+w $RUSTUP_HOME $CARGO_HOME

COPY apps/api/pnpm-lock.yaml apps/api/pnpm-workspace.yaml apps/api/package.json ./
COPY apps/api/patches ./patches
COPY apps/api/native ./native

RUN --mount=type=cache,id=pnpm-pi5,target=/pnpm/store \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/native/target \
    pnpm install --frozen-lockfile

COPY apps/api/ ./

RUN rm -rf dist && pnpm run build && \
    test -s dist/src/harness.js && \
    test -s dist/src/pi5/server.js && \
    pnpm prune --prod --ignore-scripts

FROM base AS playwright-build
WORKDIR /pw
COPY apps/playwright-service-ts/package.json apps/playwright-service-ts/pnpm-lock.yaml apps/playwright-service-ts/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/playwright-service-ts/ ./
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN pnpm exec playwright install chromium && pnpm run build

FROM base AS runtime

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=api-build /app/node_modules ./node_modules
COPY --from=api-build /app/dist ./dist
COPY --from=api-build /app/native ./native
COPY --from=go-build /app/sharedLibs/go-html-to-md/libhtml-to-markdown.so ./sharedLibs/go-html-to-md/libhtml-to-markdown.so

COPY --from=playwright-build /pw /opt/playwright
COPY --from=playwright-build /ms-playwright /ms-playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_SERVICE_DIR=/opt/playwright
RUN cd /opt/playwright && node node_modules/playwright/cli.js install-deps chromium \
    && rm -rf /var/lib/apt/lists/*

ENV PI5_PROFILE=true \
    HOST=0.0.0.0 \
    PORT=3002 \
    USE_DB_AUTHENTICATION=false \
    PLAYWRIGHT_MICROSERVICE_URL=http://127.0.0.1:3000/scrape \
    MAX_CONCURRENT_PAGES=16 \
    BLOCK_MEDIA=true \
    LOGGING_LEVEL=warn \
    SEARXNG_ENDPOINT=

EXPOSE 3002
CMD ["node", "dist/src/harness.js", "--start-pi5"]
